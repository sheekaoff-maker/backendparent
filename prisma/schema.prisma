generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PARENT
  CHILD_DEVICE
  GATEWAY
  ADMIN
}

enum DeviceType {
  ANDROID_PHONE
  ANDROID_TABLET
  IPHONE
  IPAD
  XBOX
  PLAYSTATION
  NINTENDO
  STEAM_DECK
  PC
  MAC
  SMART_TV
  STREAMING_BOX
  OTHER
}

enum ControlMethod {
  ANDROID_AGENT
  IOS_SCREEN_TIME
  XBOX_ADAPTER
  NETWORK_GATEWAY
  DNS_FILTERING
  ROUTER_GATEWAY
  XBOX_ACCOUNT
  OFFICIAL_PARENTAL_GUIDE
  MOCK
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  BLOCKED
  PAUSED
}

enum SessionStatus {
  ACTIVE
  PAUSED
  STOPPED
  EXPIRED
  VIOLATED
}

enum RuleType {
  DAILY_LIMIT
  BEDTIME
  SCHOOL_TIME
  WEEKEND_MODE
  REWARD_EXTRA_TIME
  BLOCKED_APPS
  BLOCKED_CATEGORIES
}

enum CommandType {
  BLOCK_APPS
  UNBLOCK_APPS
  LOCK_DEVICE
  START_VPN_DNS
  STOP_VPN_DNS
  REPORT_USAGE
  SYNC_RULES
}

enum CommandStatus {
  PENDING
  DELIVERED
  ACKNOWLEDGED
  FAILED
}

enum NotificationType {
  TIME_10_MIN_LEFT
  TIME_ENDED
  DEVICE_BLOCKED
  CHILD_REQUEST_MORE_TIME
  PARENT_APPROVED
  PARENT_DENIED
  POSSIBLE_DNS_BYPASS
  OFFLINE_SETUP_INCOMPLETE
  PROTECTION_LOW
  REPEATED_BYPASS
  DEVICE_DISCONNECTED
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  FAMILY
}

enum BlockCategory {
  GAMING
  STREAMING
  SOCIAL
  ADULT
  CUSTOM
}

enum BlockingMode {
  GAMING_ONLY
  FULL_INTERNET_LOCK
}

enum ProtectionStatus {
  NORMAL
  POSSIBLE_DNS_BYPASS
  COMPROMISED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  role                Role      @default(PARENT)
  firstName           String?
  lastName            String?
  refreshToken        String?
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  children      Child[]
  devices       Device[]
  sessions      Session[]
  gateways      Gateway[]
  oauthAccounts OAuthAccount[]
  notifications NotificationEvent[]
  auditLogs     AuditLog[]
  subscription  Subscription?
  pushTokens    PushToken[]

  @@map("users")
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  platform   String // ios | android | web
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Child {
  id           String   @id @default(uuid())
  parentId     String   @map("parent_id")
  name         String
  avatar       String?
  age          Int?
  defaultLimit Int?     @map("default_limit_minutes")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  parent         User            @relation(fields: [parentId], references: [id], onDelete: Cascade)
  devices        Device[]
  rules          Rule[]
  sessions       Session[]
  usageLogs      UsageLog[]
  categoryBlocks CategoryBlock[]

  @@index([parentId])
  @@map("children")
}

model Device {
  id                      String           @id @default(uuid())
  childId                 String?          @map("child_id")
  parentId                String           @map("parent_id")
  name                    String
  type                    DeviceType
  platform                String?
  macAddress              String?          @map("mac_address")
  ipAddress               String?          @map("ip_address")
  // Populated by gateway-agent's IPv6 neighbor-table discovery alongside
  // ipAddress (v4). Enforcement (firewall/DNS-redirect/conntrack) mirrors
  // every v4 rule with a v6 equivalent whenever this is set — see
  // gateway-agent/src/iptables-controller.js / nftables-controller.js.
  ipv6Address             String?          @map("ipv6_address")
  status                  DeviceStatus     @default(ONLINE)
  controlMethod           ControlMethod    @default(MOCK)
  lastSeen                DateTime?        @map("last_seen")
  dnsSourceIp             String?          @map("dns_source_ip")
  dnsConfigured           Boolean          @default(false) @map("dns_configured")
  lastDnsSeenAt           DateTime?        @map("last_dns_seen_at")
  blockingMode            BlockingMode     @default(GAMING_ONLY) @map("blocking_mode")
  internetLocked          Boolean          @default(false) @map("internet_locked")
  internetLockedReason    String?          @map("internet_locked_reason")
  internetLockedAt        DateTime?        @map("internet_locked_at")
  protectionStatus        ProtectionStatus @default(NORMAL) @map("protection_status")
  protectionScore         Int              @default(100) @map("protection_score")
  lastBypassDetectedAt    DateTime?        @map("last_bypass_detected_at")
  bypassAttempts          Int              @default(0) @map("bypass_attempts")
  typicalActiveHours      Json?            @map("typical_active_hours")
  dnsQueryPatternHash     String?          @map("dns_query_pattern_hash")
  dailyLimitMinutes       Int?             @map("daily_limit_minutes")
  bedtimeStart            String?          @map("bedtime_start")
  bedtimeEnd              String?          @map("bedtime_end")
  autoBlockEnabled        Boolean          @default(false) @map("auto_block_enabled")
  offlineControlEnabled   Boolean          @default(false) @map("offline_control_enabled")
  offlineControlMethod    String?          @map("offline_control_method")
  offlineSetupCompletedAt DateTime?        @map("offline_setup_completed_at")
  offlineSetupVerified    Boolean          @default(false) @map("offline_setup_verified")
  offlineControlNotes     String?          @map("offline_control_notes")
  gatewayId               String?          @map("gateway_id")
  hostname                String?          @map("hostname")
  dhcpClientId            String?          @map("dhcp_client_id")
  vendorOui               String?          @map("vendor_oui")
  osHint                  String?          @map("os_hint")
  fingerprintHash         String?          @map("fingerprint_hash")
  fingerprintUpdatedAt    DateTime?        @map("fingerprint_updated_at")
  vpnBlockEnabled         Boolean          @default(true) @map("vpn_block_enabled")
  quicBlockEnabled        Boolean          @default(false) @map("quic_block_enabled")
  // --- DNS auto-pairing (replaces manual IP entry — see PairingSession) ---
  paired                  Boolean          @default(false)
  pairStatus              PairStatus       @default(WAITING) @map("pair_status")
  pairedAt                DateTime?        @map("paired_at")
  // Which dns-service instance/region completed the pairing handshake —
  // meaningless today (one resolver), forward-compatible with a
  // multi-region resolver fleet without a schema change later.
  resolverRegion          String?          @map("resolver_region")
  // Mirrors dnsSourceIp at the moment it's written — kept as a separate,
  // display-oriented column (see PairingSession.confirm) so `dnsSourceIp`
  // (the DNS-policy hot-path lookup key, already indexed and relied on by
  // dns-policy.service.ts) is never repurposed for a UI concern.
  publicIp                String?          @map("public_ip")
  // Long-lived, non-expiring, non-single-use — issued once at pairing time.
  // Reuses the exact same probe mechanism as the one-time pairing token
  // (same `<token>.pair.guardtime.local` hostname pattern, same internal
  // confirm endpoint) so the parent app can silently re-send the probe
  // periodically / on network-change events to keep dnsSourceIp correct
  // as the household's public IP changes over time — no re-pairing, no
  // manual reconfiguration. See PairingService.confirmProbe.
  dnsBeaconToken          String?          @unique @map("dns_beacon_token")
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  child            Child?                   @relation(fields: [childId], references: [id], onDelete: SetNull)
  parent           User                     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  gateway          Gateway?                 @relation(fields: [gatewayId], references: [id], onDelete: SetNull)
  sessions         Session[]
  usageLogs        UsageLog[]
  commands         Command[]
  offlineChecklist OfflineControlChecklist?
  pairingSessions  PairingSession[]
  ipHistory        DeviceIpHistory[]
  connectionEvents DeviceConnectionEvent[]

  // DNS policy hot path resolves a device by source IP on every cache miss.
  @@index([ipAddress])
  @@index([dnsSourceIp])
  @@index([ipv6Address])
  @@index([parentId])
  @@index([gatewayId, macAddress])
  @@index([fingerprintHash])
  @@index([pairStatus])
  @@map("devices")
}

enum PairStatus {
  WAITING
  PAIRED
  EXPIRED
  FAILED
}

/// Ephemeral pairing handshake state — one row per in-progress "Test DNS
/// Connection" attempt. Deleted on successful confirm (the permanent
/// record of that event lives in DeviceConnectionEvent instead); left to
/// expire naturally otherwise. Never holds more than a few minutes of
/// data per device, so no retention/cleanup job beyond the existing
/// expiresAt check at read time — see PairingService.
model PairingSession {
  id        String     @id @default(cuid())
  deviceId  String     @map("device_id")
  parentId  String     @map("parent_id")
  // UUID v4 (122 bits of randomness) — generated via crypto.randomUUID(),
  // never derived from anything guessable (device id, timestamp, etc).
  token     String     @unique
  status    PairStatus @default(WAITING)
  expiresAt DateTime   @map("expires_at")
  // Incremented on every confirm attempt against this session — caps
  // brute-force/replay attempts at the application layer in addition to
  // the token's own 128-bit search space (see PairingService.MAX_ATTEMPTS).
  attempts  Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([expiresAt])
  @@map("pairing_sessions")
}

/// Append-only, one row per distinct public IP a device has ever been
/// seen from (upserted — NOT one row per DNS query, which would be
/// unbounded). This is what "keep previous IP history" means in
/// practice: a compact list of every network the device has connected
/// through, not a query log (DnsQueryLog already exists for that).
model DeviceIpHistory {
  id          String   @id @default(cuid())
  deviceId    String   @map("device_id")
  ipAddress   String   @map("ip_address")
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, ipAddress])
  @@index([deviceId, lastSeenAt])
  @@map("device_ip_history")
}

enum ConnectionEventType {
  PAIRED
  UNPAIRED
  IP_CHANGED
  RECONNECTED
  CONNECTION_LOST
}

/// Permanent audit trail for the pairing/connection lifecycle — separate
/// from DeviceIpHistory (which tracks *which IPs*) so "what happened and
/// when" stays queryable without scanning the IP table.
model DeviceConnectionEvent {
  id        String              @id @default(cuid())
  deviceId  String              @map("device_id")
  type      ConnectionEventType
  ipAddress String?             @map("ip_address")
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("device_connection_events")
}

model UnknownDomainLog {
  id                String         @id @default(cuid())
  domain            String
  sourceIp          String         @map("source_ip")
  deviceId          String?        @map("device_id")
  count             Int            @default(1)
  firstSeenAt       DateTime       @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime       @default(now()) @map("last_seen_at")
  suggestedCategory BlockCategory? @map("suggested_category")
  classified        Boolean        @default(false)

  @@unique([domain, deviceId], name: "domain_device_unique")
  @@index([classified])
  @@index([lastSeenAt])
  @@map("unknown_domain_logs")
}

model BandwidthLimit {
  id           String         @id @default(cuid())
  parentId     String         @map("parent_id")
  childId      String?        @map("child_id")
  deviceId     String?        @map("device_id")
  category     BlockCategory?
  downloadKbps Int?           @map("download_kbps")
  uploadKbps   Int?           @map("upload_kbps")
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([childId])
  @@index([deviceId])
  @@map("bandwidth_limits")
}

model VpnDetectionLog {
  id                String   @id @default(cuid())
  gatewayId         String   @map("gateway_id")
  deviceId          String   @map("device_id")
  provider          String
  method            String
  detail            String?
  // Per-signal weight (0-100) and the noisy-OR combined per-device score for
  // this detection cycle — both nullable since older gateway-agent builds
  // don't send them yet.
  confidence        Int?     @map("confidence")
  overallConfidence Int?     @map("overall_confidence")
  detectedAt        DateTime @default(now()) @map("detected_at")

  @@index([deviceId])
  @@index([gatewayId, detectedAt])
  @@map("vpn_detection_logs")
}

model OfflineControlChecklist {
  id                    String   @id @default(cuid())
  deviceId              String   @unique @map("device_id")
  pinEnabled            Boolean  @default(false) @map("pin_enabled")
  childAccountLinked    Boolean  @default(false) @map("child_account_linked")
  playTimeLimitEnabled  Boolean  @default(false) @map("play_time_limit_enabled")
  ageRatingEnabled      Boolean  @default(false) @map("age_rating_enabled")
  purchasesBlocked      Boolean  @default(false) @map("purchases_blocked")
  networkSettingsLocked Boolean  @default(false) @map("network_settings_locked")
  notes                 String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@map("offline_control_checklists")
}

model Rule {
  id                String   @id @default(uuid())
  childId           String   @map("child_id")
  type              RuleType
  value             String
  startTime         String?  @map("start_time")
  endTime           String?  @map("end_time")
  daysOfWeek        String?  @map("days_of_week")
  blockedApps       String[] @map("blocked_apps")
  blockedCategories String[] @map("blocked_categories")
  extraMinutes      Int?     @map("extra_minutes")
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, active])
  @@map("rules")
}

model Session {
  id               String        @id @default(uuid())
  deviceId         String        @map("device_id")
  childId          String        @map("child_id")
  parentId         String        @map("parent_id")
  status           SessionStatus @default(ACTIVE)
  startedAt        DateTime      @default(now()) @map("started_at")
  pausedAt         DateTime?     @map("paused_at")
  resumedAt        DateTime?     @map("resumed_at")
  stoppedAt        DateTime?     @map("stopped_at")
  expiredAt        DateTime?     @map("expired_at")
  durationMinutes  Int           @map("duration_minutes")
  remainingMinutes Int           @map("remaining_minutes")
  extendedMinutes  Int           @default(0) @map("extended_minutes")
  violated         Boolean       @default(false)
  activeApp        String?       @map("active_app")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)
  parent User   @relation(fields: [parentId], references: [id], onDelete: Cascade)

  // DNS policy + session lookups filter by device and status.
  @@index([deviceId, status])
  @@index([parentId])
  @@map("sessions")
}

model UsageLog {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  childId     String   @map("child_id")
  appName     String?  @map("app_name")
  category    String?
  durationSec Int      @map("duration_seconds")
  loggedAt    DateTime @default(now()) @map("logged_at")

  device Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  child  Child  @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([deviceId, loggedAt])
  @@index([childId, loggedAt])
  @@map("usage_logs")
}

model Command {
  id          String        @id @default(uuid())
  deviceId    String        @map("device_id")
  type        CommandType
  payload     String?
  status      CommandStatus @default(PENDING)
  deliveredAt DateTime?     @map("delivered_at")
  ackedAt     DateTime?     @map("acked_at")
  createdAt   DateTime      @default(now())

  device Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  acks   CommandAck[]

  @@index([deviceId, status])
  @@map("commands")
}

model CommandAck {
  id         String   @id @default(uuid())
  commandId  String   @map("command_id")
  success    Boolean
  resultData String?  @map("result_data")
  ackedAt    DateTime @default(now()) @map("acked_at")

  command Command @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@index([commandId])
  @@map("command_acks")
}

model Gateway {
  id        String    @id @default(uuid())
  parentId  String    @map("parent_id")
  name      String
  token     String    @unique
  endpoint  String?
  paired    Boolean   @default(false)
  pairedAt  DateTime? @map("paired_at")
  lastSeen  DateTime? @map("last_seen")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Token rotation grace period: the just-rotated-out token stays valid
  // until previousTokenExpiresAt so an already-running gateway-agent (which
  // only learns its new token from a policy-poll response, not instantly)
  // isn't locked out mid-rotation. Both nullable — most gateways have never
  // rotated.
  previousToken          String?   @unique @map("previous_token")
  previousTokenExpiresAt DateTime? @map("previous_token_expires_at")

  parent  User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  devices Device[]

  @@index([parentId])
  @@map("gateways")
}

enum RouterIntegrationStatus {
  OFFICIAL_API
  GUIDE_ONLY
  UNDETECTED
}

enum RouterDetectionMethod {
  UPNP
  SSDP
  MDNS
  DHCP_FINGERPRINT
  HTTP_HEADER
  OUI_LOOKUP
  MANUAL
}

enum RouterCommandType {
  DETECT
  TEST_CONNECTION
  CHANGE_DNS
  PAUSE_DEVICE
  RESUME_DEVICE
  DISCONNECT_CLIENT
  APPLY_FIREWALL_RULE
  REMOVE_FIREWALL_RULE
  BLOCK_MAC
  UNBLOCK_MAC
  END_GAMING_SESSION
  BLOCK_DEVICE
  UNBLOCK_DEVICE
}

/// Router Integration Engine: the router actually detected on a gateway's
/// LAN, and whichever vendor plugin (if any) GuardTime can use to control
/// it. One row per Gateway — a customer's gateway-agent sits near exactly
/// one router. `adminCredentialsEncrypted` is AES-256-GCM ciphertext
/// (see router-credentials.util.ts); it is decrypted only server-side when
/// building a response for the owning, authenticated gateway, and is never
/// logged or returned to the parent app.
model DetectedRouter {
  id                        String                  @id @default(cuid())
  gatewayId                 String                  @unique @map("gateway_id")
  vendor                    String?
  model                     String?
  firmwareVersion           String?                 @map("firmware_version")
  pluginId                  String?                 @map("plugin_id")
  integrationStatus         RouterIntegrationStatus @default(UNDETECTED) @map("integration_status")
  detectionMethod           RouterDetectionMethod?  @map("detection_method")
  confidence                Int?
  macOui                    String?                 @map("mac_oui")
  ipAddress                 String?                 @map("ip_address")
  hostname                  String?
  adminCredentialsEncrypted String?                 @map("admin_credentials_encrypted")
  lastDetectedAt            DateTime?               @map("last_detected_at")
  lastTestedAt              DateTime?               @map("last_tested_at")
  lastTestResult            Boolean?                @map("last_test_result")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  @@map("detected_routers")
}

/// Layer 8 (Router Integration Engine): a durable, retryable queued action
/// for gateway-agent to execute against the detected router — the same
/// PENDING/DELIVERED/ACKNOWLEDGED/FAILED lifecycle as `Command`, reusing
/// its `CommandStatus` enum, just scoped to a gateway instead of a device.
model RouterCommand {
  id          String            @id @default(cuid())
  gatewayId   String            @map("gateway_id")
  deviceId    String?           @map("device_id")
  type        RouterCommandType
  payload     String?
  status      CommandStatus     @default(PENDING)
  resultData  String?           @map("result_data")
  createdAt   DateTime          @default(now())
  deliveredAt DateTime?         @map("delivered_at")
  ackedAt     DateTime?         @map("acked_at")

  @@index([gatewayId, status])
  @@index([deviceId])
  @@map("router_commands")
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  provider       String
  providerUserId String   @map("provider_user_id")
  accessToken    String   @map("access_token")
  refreshToken   String   @map("refresh_token")
  tokenExpiresAt DateTime @map("token_expires_at")
  scope          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("oauth_accounts")
}

model NotificationEvent {
  id         String           @id @default(uuid())
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  message    String
  deviceId   String?          @map("device_id")
  childId    String?          @map("child_id")
  sessionId  String?          @map("session_id")
  read       Boolean          @default(false)
  sentViaFcm Boolean          @default(false) @map("sent_via_fcm")
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("notification_events")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model BlockedDomain {
  id        String         @id @default(cuid())
  domain    String         @unique
  category  BlockCategory?
  wildcard  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([category])
  @@map("blocked_domains")
}

model CategoryBlock {
  id        String        @id @default(cuid())
  childId   String        @map("child_id")
  category  BlockCategory
  reason    String?
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, category])
  @@map("category_blocks")
}

model SetupGuide {
  id        String   @id @default(cuid())
  platform  String   @unique
  title     String
  steps     Json
  videoUrl  String?  @map("video_url")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("setup_guides")
}

model DnsQueryLog {
  id        String   @id @default(cuid())
  domain    String
  sourceIp  String   @map("source_ip")
  action    String
  createdAt DateTime @default(now())

  @@index([sourceIp])
  @@index([createdAt])
  @@map("dns_query_logs")
}

model Subscription {
  id                 String           @id @default(uuid())
  userId             String           @unique @map("user_id")
  plan               SubscriptionPlan @default(FREE)
  stripeId           String?          @map("stripe_id")
  active             Boolean          @default(true)
  currentPeriodStart DateTime?        @map("current_period_start")
  currentPeriodEnd   DateTime?        @map("current_period_end")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}
