# ─── Database ───
# connection_limit + pool_timeout matter at scale: Prisma opens up to
# connection_limit connections PER PROCESS. With N backend replicas that's
# N * connection_limit total connections against Postgres — Postgres's own
# default max_connections is 100, so at, say, 10 replicas x connection_limit=10
# you're already at the ceiling before anything else connects (health checks,
# psql, migrations). Size connection_limit to (Postgres max_connections * 0.8)
# / (max expected replica count), not to how many you'd *like* per replica.
# pool_timeout is how long a query waits for a free connection before
# erroring — fail fast rather than queue silently under load.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parental_control?schema=public&connection_limit=10&pool_timeout=10"
# Direct (non-pooled) connection used by Prisma migrations — required when
# DATABASE_URL points at PgBouncer (see below), since `prisma migrate deploy`
# needs a real connection to run DDL and PgBouncer transaction mode can't
# carry that.
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/parental_control?schema=public"
#
# ─── PgBouncer (recommended once you're running more than 1-2 backend
# replicas — pools connections at the network level instead of leaving each
# replica to hold its own connection_limit open against Postgres directly) ───
# When DATABASE_URL points at PgBouncer running in transaction pooling mode,
# add `pgbouncer=true` so Prisma disables prepared statements (PgBouncer's
# transaction mode can't guarantee a prepared statement survives to the next
# query on the same logical connection):
# DATABASE_URL="postgresql://postgres:postgres@pgbouncer-host:6432/parental_control?schema=public&pgbouncer=true"
# DIRECT_URL must still point straight at Postgres (bypassing PgBouncer) for
# migrations, since `prisma migrate deploy` needs DDL support PgBouncer's
# transaction mode doesn't provide:
# DIRECT_URL="postgresql://postgres:postgres@postgres-host:5432/parental_control?schema=public"

# ─── Redis ───
# Preferred: a single connection URL (Railway/Upstash/Heroku provide this)
# REDIS_URL="redis://default:password@host:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── JWT (secrets MUST be >= 32 chars; app refuses to boot otherwise) ───
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production-32-chars-min
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption (used to encrypt OAuth tokens at rest; >= 32 chars) ───
ENCRYPTION_KEY=change-me-32-char-encryption-key!

# ─── CORS ───
# Comma-separated list of allowed browser origins (the web portal). In
# non-production, http://localhost:3000 and :5173 are added automatically.
CORS_ORIGINS=https://waqti.pro,https://www.waqti.pro

# ─── Microsoft OAuth (for Xbox integration) ───
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://api.waqti.pro/oauth/microsoft/callback

# ─── Firebase Cloud Messaging (push notifications, via firebase-admin) ───
# Leave all of these blank to disable push (notifications are still stored for
# the in-app center). The legacy FCM_SERVER_KEY is not used — Google shut that
# API down in 2024; firebase-admin uses HTTP v1 under the hood.
#
# Recommended for this deployment — path to the service-account JSON already
# provisioned on the VPS:
FIREBASE_SERVICE_ACCOUNT_PATH=/opt/guardtime/secrets/firebase-service-account.json
#
# Alternative 1: the standard Google/Firebase env var (equivalent effect):
# GOOGLE_APPLICATION_CREDENTIALS=/opt/guardtime/secrets/firebase-service-account.json
#
# Alternative 2 (back-compat): discrete fields instead of a file.
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# Paste the private_key value verbatim (with literal \n escapes) in quotes.
# FCM_PRIVATE_KEY=

# ─── DNS / Gateway ───
# When STRICT_MODE=true the DNS policy service blocks well-known DoH resolvers.
STRICT_MODE=false
# Public IP of the production DNS resolver (this VPS).
DNS_SERVICE_IP=169.58.30.9
# CONTROLLED_DNS_IP=169.58.30.9

# ─── Observability ───
# Prometheus scrapes GET /metrics automatically — no config needed, but
# restrict it to internal/trusted network at the reverse proxy (see
# deploy/nginx/guardtime.conf).
#
# OpenTelemetry tracing is OFF unless this is set — leave it unset if you
# have no collector running; the app boots normally either way.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=guardtime-backend

# ─── Server ───
PORT=3000
NODE_ENV=production
