# ─── Database ───
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/parental_control?schema=public"
# Optional: direct (non-pooled) connection used by Prisma migrations on some hosts
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/parental_control?schema=public"

# ─── Redis ───
# Preferred: a single connection URL (Railway/Upstash/Heroku provide this)
# REDIS_URL="redis://default:password@host:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_TLS=false

# ─── JWT (secrets MUST be >= 32 chars; app refuses to boot otherwise) ───
JWT_SECRET=change-me-in-production-use-64-char-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-in-production-32-chars-min
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── Encryption (used to encrypt OAuth tokens at rest; >= 32 chars) ───
ENCRYPTION_KEY=change-me-32-char-encryption-key!

# ─── CORS ───
# Comma-separated list of allowed browser origins (the web portal). In
# non-production, http://localhost:3000 and :5173 are added automatically.
CORS_ORIGINS=https://waqti.pro,https://www.waqti.pro

# ─── Microsoft OAuth (for Xbox integration) ───
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://api.waqti.pro/oauth/microsoft/callback

# ─── Firebase Cloud Messaging (push notifications, HTTP v1) ───
# From your Firebase service-account JSON. Leave blank to disable push
# (notifications are still stored for the in-app center). The legacy
# FCM_SERVER_KEY is no longer used — Google shut that API down in 2024.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the private_key value verbatim (with literal \n escapes) in quotes.
FCM_PRIVATE_KEY=

# ─── DNS / Gateway ───
# When STRICT_MODE=true the DNS policy service blocks well-known DoH resolvers.
STRICT_MODE=false
# Public IP of the production DNS resolver (this VPS).
DNS_SERVICE_IP=169.58.30.9
# CONTROLLED_DNS_IP=169.58.30.9

# ─── Server ───
PORT=3000
NODE_ENV=production
